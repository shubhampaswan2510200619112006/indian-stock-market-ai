# ════════════════════════════════════════════════════════════════
# INDIAN MARKET INTELLIGENCE — .gitignore
# Covers: Python backend + React/Vite/TypeScript frontend + SQLite
# ════════════════════════════════════════════════════════════════

# ── SECRETS & CREDENTIALS (NEVER commit these) ──────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# ── PYTHON ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
*.log
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# Virtual environments
venv/
env/
ENV/
.venv/
.env/
pythonenv*/

# ── DATABASE & DATA FILES ────────────────────────────────────────
# SQLite databases (large binary files, regenerated on setup)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Research data outputs (large, reproducible via pipeline)
data/phase*/
data/paper_state/archives/
data/bhavcopy/

# Keep these data files (small JSON research gates):
!data/research_hypothesis_registry.json
!data/phase10a/final_gate.json
!data/phase10b/final_gate.json
!data/phase12/acquisition_decision_package.json

# Parquet / CSV dumps
*.parquet
*.csv.gz

# ── ML MODEL ARTIFACTS ───────────────────────────────────────────
models/registry/*.pkl
models/registry/*.joblib
models/registry/*.json
models/*.pkl
models/*.joblib
*.h5
*.onnx

# ── NODE / FRONTEND ──────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/dist-ssr/
frontend/*.local

# Build outputs
dist/
build/
.output/
.nuxt/
.next/

# ── VITE / TAILWIND ──────────────────────────────────────────────
*.local
.vite-inspect/

# ── LOGS ─────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS / EDITOR ──────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# VS Code (keep workspace settings but not personal)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains / PyCharm
.idea/
*.iml
*.iws

# Cursor / Windsurf
.cursor/

# ── STREAMLIT ────────────────────────────────────────────────────
.streamlit/secrets.toml
.streamlit/*.toml

# ── JUPYTER ──────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── TEMPORARY ────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# ── TESTING ──────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage/

# ── DOCKER ───────────────────────────────────────────────────────
*.env.docker

# ════════════════════════════════════════════════════════════════
# WHAT IS INTENTIONALLY INCLUDED (not ignored):
# - src/          Python source code
# - frontend/src/ React/TypeScript source
# - tests/        Full test suite (658 tests)
# - docs/         All documentation
# - dashboard/    Streamlit pages
# - data/research_hypothesis_registry.json
# - requirements.txt, package.json, vite.config.ts
# ════════════════════════════════════════════════════════════════
