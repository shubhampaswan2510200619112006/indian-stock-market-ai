# =============================================================================
# Indian Options AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite (default for local dev — works out of the box):
DATABASE_URL=sqlite:///./data/indian_options.db

# PostgreSQL (recommended for production / large historical datasets):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/indian_options_ai

# -----------------------------------------------------------------------------
# Data Providers
# -----------------------------------------------------------------------------
# Active market data provider: "nse" (free/experimental) | future: "kite", "dhan", "fyers", "breeze", "angelone"
MARKET_DATA_PROVIDER=nse

# Active options data provider: "nse" (free/experimental) | future: broker providers
OPTIONS_DATA_PROVIDER=nse

# -----------------------------------------------------------------------------
# Phase 16 — Intraday Data Providers (MARKET DATA ONLY — never for trading)
# These providers are used ONLY for data ingestion. They MUST NOT be used to
# place, modify, or cancel orders. ALLOW_LIVE_EXECUTION remains hardcoded False.
# -----------------------------------------------------------------------------

# Zerodha Kite Connect — market data API
# API key and secret are permanent; access token must be obtained daily via OAuth.
# See: https://kite.trade/docs/connect/v3/
# KITE_API_KEY=your_kite_api_key_here
# KITE_API_SECRET=your_kite_api_secret_here
# KITE_ACCESS_TOKEN=your_daily_access_token_here   # Refresh daily via OAuth

# Upstox — market data API (fallback to Kite for intraday)
# See: https://upstox.com/developer/api-documentation/
# UPSTOX_API_KEY=your_upstox_api_key_here
# UPSTOX_API_SECRET=your_upstox_api_secret_here
# UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# Legacy broker API keys (for other future provider integrations)
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=
# FYERS_APP_ID=
# FYERS_SECRET_KEY=
# ANGELONE_API_KEY=
# ANGELONE_CLIENT_ID=
# BREEZE_API_KEY=
# BREEZE_API_SECRET=

# -----------------------------------------------------------------------------
# Phase 16 — Bhavcopy Archive Settings
# -----------------------------------------------------------------------------
# Number of past trading days to backfill on first run (default 30)
# BHAVCOPY_BACKFILL_DAYS=30
# Local directory for raw downloaded Bhavcopy archives (SHA256-verified)
# BHAVCOPY_RAW_DIR=./data/bhavcopy/raw

# -----------------------------------------------------------------------------
# Phase 16 — Paid Historical Options Provider (stub interface only)
# Sensibull, Opstra, TrueData, GDFL — REQUIRES_VENDOR_CONFIRMATION
# DO NOT set these unless you have a confirmed subscription and verified that
# the provider actually supplies historical bid/ask data for NSE options.
# -----------------------------------------------------------------------------
# PAID_OPTIONS_PROVIDER_KEY=
# PAID_OPTIONS_PROVIDER_NAME=

# News provider
# NEWS_API_KEY=

# LLM provider (Phase 7)
# LLM_API_KEY=
# LLM_MODEL=

# -----------------------------------------------------------------------------
# Rate Limiting & Caching
# -----------------------------------------------------------------------------
# Minimum seconds between requests to the same data provider
RATE_LIMIT_DELAY_SECONDS=2.0

# Cache TTL in seconds for live market data during market hours
CACHE_TTL_LIVE_SECONDS=60

# Cache TTL for data outside market hours
CACHE_TTL_CLOSED_SECONDS=3600

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# API server
API_HOST=0.0.0.0
API_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Risk-free rate assumption (annualized, e.g., India 10Y govt bond yield)
RISK_FREE_RATE=0.07

# Timezone
TIMEZONE=Asia/Kolkata
